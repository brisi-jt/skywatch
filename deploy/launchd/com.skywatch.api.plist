<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.skywatch.api</string>
	<key>ProgramArguments</key>
	<array>
		<string>__SKYWATCH_ROOT__/.venv/bin/skywatch-api</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__SKYWATCH_ROOT__</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>__SKYWATCH_ROOT__/data/logs/api.log</string>
	<key>StandardErrorPath</key>
	<string>__SKYWATCH_ROOT__/data/logs/api.err.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>__HOMEBREW_PREFIX__/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
</dict>
</plist>
