# Station configuration. Copy to config/config.yaml and adjust for your site.
# Secrets (API keys, OAuth credentials) do not belong here — see config/.env.example.

# Root directory for station data: the SQLite database, recordings, and logs.
data_root: ./data

receiver:
  postcode: "SW1A 1AA"
  # Postcode centroid from postcodes.io (London Stansted); regenerate for a new
  # site with: uv run python scripts/geocode.py "<postcode>"
  lat: 51.5
  lon: -0.1

capture:
  # replay feeds fixture audio through the pipeline (no dongle needed);
  # live runs rtl_airband against a connected RTL-SDR.
  source: replay
  # multichannel records several frequencies inside one ~2.56 MHz window at once;
  # scan hops across arbitrary frequencies but misses concurrent traffic.
  mode: multichannel
  # How live capture controls rtl_airband: subprocess spawns it directly
  # (development); launchctl kicks the com.skywatch.rtl-airband launchd
  # service installed by scripts/bootstrap.sh (deployed stations).
  supervisor: subprocess
  device_index: 0
  # The three tuning values below (gain, squelch_snr_threshold, ppm) seed
  # the station database the first time the station starts. After that the
  # dashboard's tuning page owns them, and editing them here has no effect.
  # RTL-SDR tuner gain in dB. Auto-gain is not available; tune per site.
  gain: 32.0
  # Squelch opens when a transmission rises this many dB above the noise floor.
  squelch_snr_threshold: 12
  # Frequency correction for the dongle's crystal offset, in parts per million.
  ppm: 0
  sample_rate_msps: 2.56
  output_dir: ./data/recordings

asr:
  # faster_whisper is the default engine; whisper_cpp is the fallback for
  # machines where the ctranslate2 wheel is unavailable.
  engine: faster_whisper
  model: base.en
  compute_type: int8
  # Only used when engine is whisper_cpp: the whisper-cli binary and a ggml
  # model file (e.g. ggml-base.en.bin).
  whisper_cpp_binary: whisper-cli
  whisper_cpp_model: null

llm:
  # Classification provider chain; none = prefilter-only classification.
  provider: gemini
  model: gemini-2.5-flash-lite
  # Stay under the provider's free-tier daily request limit.
  daily_call_cap: 900
  fallback: [groq, none]
  # Models for the non-primary providers when they appear in the chain.
  groq_model: llama-3.3-70b-versatile
  ollama_url: http://localhost:11434
  ollama_model: llama3.2

enrichment:
  # Flight-data lookups for probable aircraft; none disables enrichment.
  provider: opensky
  radius_km: 40
  # Aircraft-state queries within the same bucket share one cached response.
  bucket_seconds: 30
  daily_credit_cap: 3000

retention:
  # Audio for routine clips is deleted after this many days; interesting
  # clips and all database rows are kept indefinitely.
  routine_audio_days: 14
  # Capture pauses when free disk falls below this floor and resumes once
  # pruning (or you) frees space.
  min_free_disk_gb: 2.0

server:
  host: 0.0.0.0
  port: 8000
  # Local timezone for day boundaries in the daily digest and date filters.
  timezone: Europe/London
